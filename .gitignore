# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
coverage/
dashboard/dist/
dashboard/test-results/
*.tsbuildinfo

# Local environment
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS/editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Runtime state
**/state.json
_opensquad/reports/

# Keep generated workspaces/squads lightweight by default
projects/*/squads/*/output/*
!projects/*/squads/*/output/.gitkeep
squads/*/output/*
!squads/*/output/.gitkeep

# NXT Transport: repositorios de codigo (clonados ao lado, cada um com seu git)
project-nxt-transport-*/
